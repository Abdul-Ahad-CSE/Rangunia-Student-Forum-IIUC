datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VERIFIED_STUDENT
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UpdateRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

model User {
  id                 String             @id @default(cuid())
  studentId          String             @unique // IIUC Matriculation / Student ID
  email              String             @unique
  passwordHash       String?
  fullName           String
  name               String?            // Compatibility alias for NextAuth
  photoUrl           String?            @db.Text
  gender             Gender
  department         String             // e.g. CSE, EEE, BBA, Pharmacy
  session            String             // Academic Session (e.g., Autumn 2021, Spring 2024)
  bloodGroup         BloodGroup?
  phone              String?
  address            String?
  socialLinks        Json?              // Structured JSON: { linkedin?, github?, facebook?, portfolio? }
  bio                String?            @db.Text

  // Privacy by Default Controls
  isPhoneVisible     Boolean            @default(false)
  isEmailVisible     Boolean            @default(false)
  isSocialVisible    Boolean            @default(false)

  // Status & Governance
  role               Role               @default(STUDENT)
  approvalStatus     ApprovalStatus     @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING)
  isActive           Boolean            @default(true)
  emailVerified      DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Profile Splitting (1:1 Relationships)
  studentProfile     StudentProfile?
  alumniProfile      AlumniProfile?

  // Request-Based Update Submissions
  updateRequests     ProfileUpdateRequest[]

  // Platform Modules & Relations
  verification       StudentVerification?
  bloodDonor         BloodDonor?
  auditLogs          AuditLog[]
  accounts           Account[]
  sessions           Session[]

  @@index([studentId])
  @@index([email])
  @@index([department])
  @@index([session])
  @@index([role])
  @@index([approvalStatus])
}

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSemester  String   // e.g. 1st, 4th, 8th
  cgpa             String?  // Optional / privacy protected
  skills           String[] @default([]) // Technical / soft skills
  interestedSector String?  // e.g. Web Development, AI/ML, Data Science, Telecom
  clubRole         String?  // e.g. Member, Executive, Coordinator, Volunteer
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model AlumniProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company               String?  // Current employer / Organization
  jobPosition           String?  // Professional title
  industry              String?  // e.g. Software, Banking, Telecommunications
  workLocation          String?  // e.g. Dhaka, Chittagong, Remote, Abroad
  experienceYears       Int?     // Total career experience in years
  passingYear           String?  // Passing year
  graduationYear        String?  // Degree conferral year
  higherStudyUniversity String?  // University for postgraduate studies
  higherStudyCountry    String?  // Country of higher study
  higherStudyDegree     String?  // e.g. MSc, PhD, MBA

  // Mentorship and Assistance Offering
  mentorshipAvailable   Boolean  @default(false)
  internshipHelp        Boolean  @default(false)
  cvReview              Boolean  @default(false)
  higherStudyGuidance   Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model ProfileUpdateRequest {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedData Json                // Holds draft payload for proposed changes
  status        UpdateRequestStatus @default(PENDING)
  adminNote     String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

model StudentVerification {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  idCardImageUrl   String             // Secure cloud URL of student ID card
  supportingDocUrl String?
  status           VerificationStatus @default(PENDING)
  reviewerNotes    String?            @db.Text
  verifiedAt       DateTime?
  verifiedByAdminId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([verifiedByAdminId])
}

model BloodDonor {
  id                         String      @id @default(cuid())
  userId                     String      @unique
  user                       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup                 BloodGroup
  isAvailable                Boolean     @default(false) // Private & unavailable until donor toggles
  lastDonationDate           DateTime?
  totalDonations             Int         @default(0)
  emergencyContact           String?     // Dedicated phone for emergency calls
  preferredDonationArea      String?     @default("Rangunia") // Rangunia, IIUC Campus, Chattogram City
  hideContactUnlessEmergency Boolean     @default(true) // Privacy protection shield
  medicalNotes               String?     @db.Text

  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@index([bloodGroup])
  @@index([isAvailable])
  @@index([preferredDonationArea])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String   // e.g. "USER_LOGIN", "PROFILE_UPDATED", "VERIFICATION_APPROVED", "DONOR_OPT_IN"
  entityType  String   // e.g. "User", "StudentProfile", "AlumniProfile", "BloodDonor", "Verification"
  entityId    String?
  ipAddress   String?
  userAgent   String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AdminUser {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique
  passwordHash       String
  photoUrl           String?        @db.Text // Optional profile photo (Base64 data or URL)
  studentId          String         @unique // IIUC Student ID
  department         String         // e.g., CSE, EEE, BBA
  section            String         // e.g., 5A, 4B
  phone              String         // Phone Number
  position           String         // Position in forum (e.g., General Executive)
  enrollment         String         // Enrollment session (e.g., Spring 24)
  currentAddress     String
  permanentAddress   String
  gender             String         @default("Male")
  role               Role           @default(ADMIN)
  approvalStatus     ApprovalStatus @default(PENDING)
  approvedAt         DateTime?
  rejectionReason    String?        @db.Text

  // Granular capability flags (all default to false)
  canManageProfiles  Boolean        @default(false)
  canPostNotices     Boolean        @default(false)
  canManageEvents    Boolean        @default(false)
  canManageEmergency Boolean        @default(false)

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([email])
  @@index([studentId])
  @@index([approvalStatus])
}
